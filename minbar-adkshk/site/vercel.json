{
  "version": 2,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/privacy/?", "dest": "/privacy.html" },
    { "src": "/admin-privacy/?", "dest": "/admin-privacy.html" },
    { "src": "/lesson/[^/]+/?", "dest": "/lesson.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
